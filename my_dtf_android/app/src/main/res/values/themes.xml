<resources>
    <style name="Theme.MyDTF" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@color/night</item>
        <item name="android:navigationBarColor">@color/night</item>
    </style>
    <style name="Theme.MyDTF.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MyDTF</item>
    </style>
    <color name="night">#FF090B11</color>
    <color name="gold">#FFE6B325</color>
</resources>
