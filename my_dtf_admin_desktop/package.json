{
  "name": "my-dtf-admin",
  "productName": "My DTF Admin",
  "version": "1.0.0",
  "description": "My DTF — centre de contrôle de l'atelier (administrateur)",
  "author": "My DTF",
  "main": "main.js",
  "private": true,
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis --publish never" },
  "devDependencies": { "electron": "33.2.1", "electron-builder": "25.1.8" },
  "build": {
    "appId": "com.mydtf.admin.desktop",
    "productName": "My DTF Admin",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "offline.html", "build/icon.png"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "My DTF Admin", "artifactName": "My-DTF-Admin-Setup.exe" }
  }
}
