{
  "name": "my-dtf",
  "productName": "My DTF",
  "version": "1.1.0",
  "description": "My DTF — برنامج الورشة للحاسوب: المدير والمسيّر والمصمّم والطابع",
  "author": "My DTF",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "test": "node --test test/collector.test.js"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.mydtf.desktop",
    "productName": "My DTF",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/icon.png",
      "collector/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "My DTF",
      "uninstallDisplayName": "My DTF",
      "runAfterFinish": true,
      "installerLanguages": [
        "ar_SA",
        "fr_FR",
        "en_US"
      ],
      "multiLanguageInstaller": true,
      "artifactName": "My-DTF-Setup.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/charuadejsi-del/fares/releases/download/my-dtf-desktop-latest/"
      }
    ],
    "asarUnpack": [
      "collector/printexp-probe.ps1"
    ]
  },
  "mydtf": {
    "appUrl": "https://mydtf-admin.pages.dev/"
  }
}
